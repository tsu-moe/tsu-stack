{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-maia",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "../../packages/ui/styles/shadcn.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/shared/ui",
    "utils": "@tsu-stack/ui/lib/utils",
    "ui": "@tsu-stack/ui/components",
    "lib": "@tsu-stack/ui/lib",
    "hooks": "@tsu-stack/ui/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@efferd": {
      "url": "https://efferd.com/r/{style}/{name}.json",
      "headers": {
        "Authorization": "Bearer ${EFFERD_REGISTRY_TOKEN}"
      }
    },
    "@iandefined": "https://ui.iandefined.com/r/{name}.json"
  }
}
