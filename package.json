{
  "name": "tsu-stack",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp run i18n:ensure && vp check",
    "fix": "vp run i18n:ensure && vp check --fix",
    "test:unit:run": "pnpm dotenvx run -f ./packages/env/.env -- vp run -r test:unit",
    "test:e2e:run": "pnpm dotenvx run -f ./packages/env/.env -- vp run -r test:e2e",
    "dev": "vp run i18n:ensure && pnpm -r --parallel dev",
    "build": "vp run -r build",
    "deploy": "vp run -r deploy",
    "i18n:ensure": "node -e \"const { existsSync } = require('node:fs'); if (['messages/_index.js', 'messages.js', 'registry.js', 'runtime.js', 'server.js'].some((file) => !existsSync('packages/i18n/src/paraglide/' + file))) require('node:child_process').execSync('vp run --filter @tsu-stack/i18n build', { stdio: 'inherit' })\"",
    "prepare": "vp config",
    "release": "node tools/create-tsu-stack/scripts/release.mjs",
    "deps": "vpx taze@latest -Ilwr --maturity-period 3",
    "deps:major": "vpx taze@latest major -Ilwr --maturity-period 3",
    "fallow": "vpx fallow --skip health",
    "tanstack": "vpx @tanstack/cli@latest",
    "db": "vp run --filter @tsu-stack/db db",
    "db:dev:start": "vp run --filter @tsu-stack/db db:dev:start",
    "db:dev:stop": "vp run --filter @tsu-stack/db db:dev:stop",
    "db:push": "vp run -w db push",
    "db:generate": "vp run -w db generate",
    "db:migrate": "vp run -w db migrate",
    "db:studio": "vp run -w db studio",
    "docker:up": "pnpm dotenvx run -f .env.docker docker -- compose up",
    "docker:up:build": "pnpm dotenvx run -f .env.docker docker -- compose up --build",
    "docker:down": "pnpm dotenvx run -f .env.docker docker -- compose down",
    "ui": "vp run --filter @tsu-stack/ui ui",
    "ui:web": "vp run --filter @tsu-stack/web ui",
    "auth:secret": "vpx auth@latest secret",
    "auth:generate": "vp run --filter @tsu-stack/db auth:generate"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint-plugin-fsd-lint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@12.3.1",
  "intent": {
    "skills": [
      "@tanstack/*",
      "drizzle-kit"
    ]
  }
}
